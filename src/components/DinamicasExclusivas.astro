                <div class="promo-dinamica__browser-content">
                    <div class="promo-dinamica__mock-logo"></div>
                    <div class="promo-dinamica__mock-heading"></div>
                    <div class="promo-dinamica__mock-heading promo-dinamica__mock-heading--accent"></div>
                    <div class="promo-dinamica__mock-copy"></div>
                    <div class="promo-dinamica__mock-copy promo-dinamica__mock-copy--short"></div>
                    <div class="promo-dinamica__mock-button"></div>
                </div>
            </div>

            <div class="promo-dinamica__code">
                <span aria-hidden="true">&lt;/&gt;</span>
                <p>Código propio</p>
            </div>

            <div class="promo-dinamica__badge">
                <span>INFI</span>
                <strong>WEB</strong>
                <span>A TU ALTURA</span>
            </div>
        </div>

        <ul class="promo-dinamica__benefits" aria-label="Beneficios">
            <li><span aria-hidden="true">✳</span> Diseño personalizado</li>
            <li><span aria-hidden="true">&lt;/&gt;</span> Código propio</li>

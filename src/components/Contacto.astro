<section id="Contacto" aria-labelledby="contacto-titulo">
    <div class="contacto-panel">
        <div class="contacto-panel__intro">
            <p class="contacto-panel__eyebrow">
                <span class="contacto-panel__status" aria-hidden="true"></span>
                Canal directo con InfiCode
            </p>

            <h2 id="contacto-titulo">
                Hagamos algo <span>extraordinario.</span>
            </h2>

            <p class="contacto-panel__description">
                Cuéntanos qué imaginas. Nuestro equipo está listo para convertirlo en una experiencia digital a la altura de tu negocio.
            </p>

            <a class="contacto-panel__email" href="mailto:infocode25@gmail.com">
                <span class="contacto-panel__email-icon" aria-hidden="true">↗</span>
                <span>
                    <small>También puedes escribirnos</small>
                    <strong>infocode25@gmail.com</strong>
                </span>
            </a>

            <div class="contacto-panel__signal" aria-hidden="true">
                <span></span><span></span><span></span><span></span><span></span>
                <small>LISTOS PARA CREAR</small>
            </div>
        </div>

        <form class="formulario contacto-form" action="">
            <div class="contacto-form__heading">
                <span>NUEVO PROYECTO</span>
                <h3>Empecemos la conversación</h3>
                <p>Completa tus datos y cuéntanos un poco sobre tu idea.</p>
            </div>

            <div class="contacto-form__fields">
                <div class="contacto-form__field">
                    <label for="Nombre">Nombre</label>
                    <input id="Nombre" name="Nombre" type="text" placeholder="Tu nombre completo" autocomplete="name" required>
                </div>

                <div class="contacto-form__field">
                    <label for="Correo">Email <span>(opcional)</span></label>
                    <input id="Correo" name="Correo" type="email" placeholder="tu@email.com" autocomplete="email">
                </div>

                <div class="contacto-form__field contacto-form__field--full">
                    <label for="Especializacion">Especialización o tipo de negocio</label>
                    <input id="Especializacion" name="Especializacion" type="text" placeholder="Ej. Psicología, tienda de ropa, emprendimiento" autocomplete="organization-title">
                </div>

                <div class="contacto-form__field contacto-form__field--full">
                    <label for="Mensaje">¿Qué tienes en mente?</label>
                    <textarea name="Mensaje" id="Mensaje" placeholder="Cuéntanos sobre tu proyecto..." required></textarea>
                </div>
            </div>

            <button class="contacto-form__submit" type="submit">
                Enviar mi mensaje
                <span aria-hidden="true">→</span>
            </button>

            <p class="contacto-form__note">
                <span aria-hidden="true">⌁</span>
                Tu idea está a un mensaje de empezar.
            </p>
        </form>
    </div>
</section>

---
const navLinks = [
    { name: "Inicio", href: "/" },
    { name: "Servicios", href: "#servicios" },
    { name: "Proyectos", href: "#proyectos" },
    { name: "Nosotros", href: "#nosotros" },
];
---

<header class="header">
    <nav class="nav">
        <a href="/" class="logo">
        <img src="/images/infiCode-icon_4K-png.png" alt="InfiCode Logo" />
        </a>

        <ul class="nav-links">
        {navLinks.map((link) => (
            <li><a href={link.href}>{link.name}</a></li>
        ))}
        </ul>

        <a href="#contacto" class="cta">Contáctanos</a>
    </nav>
</header>

<style>
    .header {
        position: fixed;
        top: 20px;
        width: 65%;
        padding: 5px 28px;
        border-radius: 50px;
        background: rgba(255, 255, 255, 0.09);
        transition: background 0.3s ease, backdrop-filter 0.3s ease;

          /* 🎨 Efecto glassmorphism */
        backdrop-filter: blur(12px) saturate(180%);
        -webkit-backdrop-filter: blur(12px) saturate(180%);
        background-color: rgba(255, 255, 255, 0.171); /* transparente pero visible */
        border-bottom: 1px solid rgba(255, 255, 255, 0.12);
        box-shadow: 0 4px 25px rgba(0, 0, 0, 0.2);

        transition: all 0.3s ease;
    }

    .nav {
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .logo {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: 600;
        color: #fff;
        text-decoration: none;
        font-size: 1.1rem;
    }

    .logo img {
        height: 50px;
    }

    .nav-links {
        display: flex;
        gap: 2rem;
        list-style: none;
    }

    .nav-links a {
        color: #ffffff;
        text-decoration: none;
        transition: color 0.2s ease;
        font-size: 20px;
        font-weight: 500;
    }

    .nav-links a:hover {
        color: #fff;
    }

    .cta {
        background: #3F71AE;
        font-size: 18px;
        color: white;
        padding: 0.6rem 1.2rem;
        border-radius: 9999px;
        text-decoration: none;
        font-weight: 500;
        transition: transform 0.2s ease;
    }

    .cta:hover {
        transform: scale(1.05);
    }

    /* Responsivo */
    @media (max-width: 768px) {
        .nav-links {
        display: none;
        }
    }
</style>

import Hero from "../components/Hero.astro";
import SobreInfiCode from "../components/SobreInfiCode.astro";
import Servicios from "../components/Servicios.astro";
import Proyectos from "../components/Proyectos.astro";
import DinamicasExclusivas from "../components/DinamicasExclusivas.astro";
import Contacto from "../components/Contacto.astro";
import Footer from "../components/Footer.astro";
import Preloader from "../components/Preloader.astro";
---
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="/ICONs/icon-infiCode.png">
    <link rel="stylesheet" href="/styles.css">
    <link rel="stylesheet" href="/estilos/1024.css">
    <title>infiCode | Diseño y Desarrollo Web</title>

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-9BBGC8G3BY"></script>
    <script is:inline>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());

        gtag('config', 'G-9BBGC8G3BY');
    </script>
</head>
<body>
    <Preloader />
    <Header />

    <main>
        <Hero />
        <SobreInfiCode />
        <Servicios />
        <Proyectos />
        <DinamicasExclusivas />
        <Contacto />
    </main>

    <Footer />


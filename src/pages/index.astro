---
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import SobreInfiCode from "../components/SobreInfiCode.astro";
import Servicios from "../components/Servicios.astro";
import Proyectos from "../components/Proyectos.astro";
import DinamicasExclusivas from "../components/DinamicasExclusivas.astro";
import Contacto from "../components/Contacto.astro";
import Footer from "../components/Footer.astro";
import Preloader from "../components/Preloader.astro";

const seoTitle = "Diseño y desarrollo web en Colombia | infiCode";
const seoDescription =
    "Creamos páginas web, catálogos digitales y tiendas virtuales para empresas y profesionales en Colombia. Cuéntanos tu proyecto.";
const canonicalURL = new URL("/", Astro.site);
const socialImageURL = new URL("/IMGs/infiCode-icon_4K.jpg", Astro.site);
---
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content={seoDescription}>
    <link rel="canonical" href={canonicalURL.href}>
    <link rel="icon" href="/ICONs/icon-infiCode.png">
    <link rel="stylesheet" href="/styles.css">
    <link rel="stylesheet" href="/estilos/1024.css">
    <title>{seoTitle}</title>
    <meta property="og:type" content="website">
    <meta property="og:locale" content="es_CO">
    <meta property="og:site_name" content="infiCode">
    <meta property="og:title" content={seoTitle}>
    <meta property="og:description" content={seoDescription}>
    <meta property="og:url" content={canonicalURL.href}>
    <meta property="og:image" content={socialImageURL.href}>
    <meta property="og:image:alt" content="Símbolo de infiCode">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={seoTitle}>
    <meta name="twitter:description" content={seoDescription}>
    <meta name="twitter:image" content={socialImageURL.href}>
    <meta name="twitter:image:alt" content="Símbolo de infiCode">

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-9BBGC8G3BY"></script>
    <script is:inline>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());

        gtag('config', 'G-9BBGC8G3BY');
    </script>
</head>
<body>
    <Preloader />
    <Header />

    <main>
        <Hero />
        <SobreInfiCode />
        <Servicios />
        <Proyectos />
        <DinamicasExclusivas />
        <Contacto />
    </main>

    <Footer />

    <script is:inline src="/main.js"></script>
</body>
</html>
